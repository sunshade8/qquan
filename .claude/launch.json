{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "qquant-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "qquant-dev-v1policy",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "QQUAN_CT_POLICY_VERSION=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log npx vinext dev --port 3001"
      ],
      "port": 3001
    },
    {
      "name": "qquant-research-run",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "WRANGLER_LOG_PATH=.wrangler/wrangler.log node --env-file=.dev.vars node_modules/.bin/vinext dev --port 3000"
      ],
      "port": 3000
    }
  ]
}