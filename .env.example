# Server-only. Never expose this value with a NEXT_PUBLIC_ prefix.
ANTHROPIC_API_KEY=
# Frontier tier: Lab JARVIS orchestrator, final synthesis, strategy design.
ANTHROPIC_MODEL=claude-opus-5
# Balanced tier: headline sentiment scoring, pattern analyst/auditor, request planner.
ANTHROPIC_MODEL_BALANCED=claude-sonnet-5
# Fast tier: intent routing and summarisation.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Frontier tier provider. Set to `openai` to route the orchestrator / synthesizer /
# strategist roles to OpenAI GPT-6 Astra via the Responses API (built-in web_search,
# reasoning.effort). Anything else (or unset) keeps them on Anthropic (ANTHROPIC_MODEL).
# Balanced and fast tiers always stay on Anthropic and still need ANTHROPIC_API_KEY.
LLM_FRONTIER_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=xhigh
# Override only if the account needs the dated web search slug (e.g. web_search_2025_08_26).
OPENAI_WEB_SEARCH_TOOL=web_search
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# The credentials above already reach the account, asset and order APIs
# (/api/v1/accounts, /holdings, /buying-power, /sellable-quantity, /commissions,
# /orders) — nothing further is required to place a real order. Everything below
# is optional tuning for lib/toss-orders.ts.
#
# Which account to trade. Defaults to the first BROKERAGE account from
# GET /api/v1/accounts; set the accountSeq to pin one.
TOSS_ACCOUNT_SEQ=
# "loc" (default) sends LIMIT + timeInForce CLS — a limit-on-close order, which is
# what the strategies backtest against. "market" sends a plain day market order.
TOSS_ORDER_MODE=loc
# How far the LOC limit sits from the reference price, in percent. The order still
# fills at the closing auction; this only caps how far the close may run against
# the order before it does not fill at all. Default 3.
TOSS_LOC_LIMIT_BAND_PCT=3
# Kill switch. Set to "true" to refuse every live order without unlinking the keys.
TOSS_TRADING_DISABLED=
# Trading dashboards (전략 tab): how far past the quote a live marketable limit is priced,
# percent per attempt (exit retries reach up to three bands). Default 1.
TRADING_LIMIT_BAND_PCT=1

# Massive Custom Bars for US stocks. Basic: 2 years, end-of-day, 5 calls/minute.
MASSIVE_API_KEY=
MASSIVE_PLAN=Basic
MASSIVE_HISTORY_YEARS=2
MASSIVE_DATA_RECENCY=end_of_day
MASSIVE_CALLS_PER_MINUTE=5

# Optional market-data adapter. The sync endpoint remains read-only/demo until configured.
MARKET_DATA_PROVIDER=unconfigured
MARKET_DATA_API_KEY=
SYNC_SECRET=

# Point-in-time macro data for the event spine (free: https://fred.stlouisfed.org/docs/api/api_key.html).
# Without it the calendar seeds schedules only and `POST /api/events {"action":"backfill"}` is refused.
FRED_API_KEY=

# Strategy Studio fixes its own model policy (independent of the Lab tier overrides):
# orchestrator/designer: gpt-6-astra; data: gpt-5.6-luna;
# independent risk/final review: claude-opus-5; report: claude-haiku-4-5-20251001.
# Both OPENAI_API_KEY and ANTHROPIC_API_KEY must have access to these exact models.
# Optional for local runner; REQUIRED on both server and runner for remote generation advances.
STRATEGY_RUNNER_SECRET=
