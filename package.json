{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "trader": "node scripts/trading-runner.mjs",
    "research:logs": "node --experimental-strip-types scripts/research/sync-journal.mjs",
    "build:vercel": "QQUAN_RUNTIME=node NITRO_PRESET=vercel vite build",
    "data:setup": "python3 -m venv .venv && .venv/bin/pip install -r scripts/data/requirements.txt",
    "data:worker": "node --env-file-if-exists=.dev.vars scripts/data/run-worker.mjs",
    "research:runner": "node --env-file-if-exists=.dev.vars scripts/trading-runner.mjs --generation-only",
    "local": "node scripts/local.mjs",
    "build:local": "QQUAN_RUNTIME=node NITRO_PRESET=node-server vite build",
    "start:local": "HOST=127.0.0.1 PORT=3000 node .output/server/index.mjs",
    "test:local": "node --experimental-strip-types --test tests/*.test.mjs && .venv/bin/python tests/local-data.test.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/functions": "^3.9.11",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "openai": "^7.9.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "nitro": "^3.0.260903-beta",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
